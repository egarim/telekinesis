<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The Windows backend needs the desktop framework, so the CLI multi-targets:
         plain net10.0 everywhere, net10.0-windows adds Telekinesis.Windows. -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Win32 manifest (per-monitor-v2 DPI) only makes sense for the Windows head. -->
    <ApplicationManifest Condition="$(TargetFramework.Contains('-windows'))">app.manifest</ApplicationManifest>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Telekinesis.Cli</RootNamespace>

    <!-- dotnet tool packaging: `dotnet tool install -g Telekinesis` → `telekinesis` -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>telekinesis</ToolCommandName>
    <PackageId>Telekinesis</PackageId>
    <Authors>Joche Ojeda</Authors>
    <Description>Telekinesis — an MCP server that lets AI agents see and control the desktop through platform accessibility APIs (AT-SPI, UIA, AXAPI). Move things without touching them.</Description>
    <PackageTags>mcp;accessibility;automation;at-spi;uia;agent;desktop</PackageTags>
    <RepositoryUrl>https://github.com/egarim/telekinesis</RepositoryUrl>
    <!-- Dual-licensed: AGPL-3.0 (this package) or commercial — see COMMERCIAL.md. -->
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>0.8.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Telekinesis.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <!-- HTTP/SSE transport for `telekinesis serve` (remote posture: read-only by default). -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Telekinesis.Abstractions\Telekinesis.Abstractions.csproj" />
    <ProjectReference Include="..\Telekinesis.Linux\Telekinesis.Linux.csproj" />
    <ProjectReference Include="..\Telekinesis.MacOS\Telekinesis.MacOS.csproj" />
    <ProjectReference Include="..\Telekinesis.Medium\Telekinesis.Medium.csproj" />
    <ProjectReference Include="..\Telekinesis.Vision\Telekinesis.Vision.csproj" />
    <ProjectReference Include="..\Telekinesis.Pilot\Telekinesis.Pilot.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
    <ProjectReference Include="..\Telekinesis.Windows\Telekinesis.Windows.csproj" />
  </ItemGroup>

  <!-- Tool packaging: PackAsTool rejects the -windows TFM, so the tool packs the plain
       net10.0 build and bundles the pre-published net10.0-windows output under win/;
       Program.cs re-execs it on Windows. Pack with:
         dotnet publish -c Release -f net10.0-windows src/Telekinesis.Cli
         dotnet pack src/Telekinesis.Cli -c Release -p:TargetFrameworks=net10.0 -p:PackWinPayload=true -o artifacts -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(PackWinPayload)' == 'true'">
    <None Include="bin\Release\net10.0-windows\publish\**"
          Pack="true"
          PackagePath="tools\net10.0\any\win"
          Visible="false" />
  </ItemGroup>

</Project>
